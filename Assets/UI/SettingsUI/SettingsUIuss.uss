.SettingsPanel {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 40px;
}

.SettingRow {
    flex-direction: row;
    align-items: center;
    margin-bottom: 20px;
    width: 400px;
}

.SettingLabel {
    font-size: 22px;
    color: rgb(220, 220, 220);
    width: 160px;
    -unity-text-align: middle-left;
}

.SettingDropdown {
    flex-grow: 1;
    height: 36px;
    font-size: 18px;
    background-color: white;
    border-radius: 6px;
    padding-left: 8px;
}

.SettingToggle {
    margin-left: 0;
}

.ButtonRow {
    flex-direction: row;
    margin-top: 40px;
}

.SettingButton {
    width: 100px;
    height: 42px;
    font-size: 18px;
    margin-left: 10px;
    margin-right: 10px;
    border-radius: 8px;
    border-width: 1px;
    color: white;
}

.SaveButton {
    background-color: rgb(60, 140, 80);
}

.SaveButton:hover {
    background-color: rgb(80, 170, 100);
}

.ResetButton {
    background-color: rgb(180, 130, 50);
}

.ResetButton:hover {
    background-color: rgb(200, 150, 70);
}

.ExitButton {
    background-color: rgb(160, 60, 60);
}

.ExitButton:hover {
    background-color: rgb(190, 80, 80);
}
