<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/SettingsUI/SettingsUIuss.uss?fileID=7433441132597879392&amp;guid=2bc9f1b728f67404cad1855e1a570d09&amp;type=3#SettingsUIuss"/>
    <ui:VisualElement class="SettingsPanel" style="flex-grow: 1; background-color: rgb(84, 53, 74); align-items: center; justify-content: center;">

        <!-- 设置标题 -->
        <ui:Label text="Settings" name="SettingsTitle" style="font-size: 36px; color: white; margin-bottom: 40px; -unity-font-style: bold;"/>

        <!-- 分辨率设置 -->
        <ui:VisualElement class="SettingRow">
            <ui:Label text="Resolution" class="SettingLabel"/>
            <ui:DropdownField name="ResolutionDropdown" class="SettingDropdown"/>
        </ui:VisualElement>

        <!-- 全屏设置 -->
        <ui:VisualElement class="SettingRow">
            <ui:Label text="Fullscreen" class="SettingLabel"/>
            <ui:Toggle name="FullscreenToggle" class="SettingToggle"/>
        </ui:VisualElement>

        <!-- 按钮区域 -->
        <ui:VisualElement class="ButtonRow">
            <ui:Button text="Save" name="Save" class="SettingButton SaveButton"/>
            <ui:Button text="Reset" name="ResetButton" class="SettingButton ResetButton"/>
            <ui:Button text="Exit" name="SettingsQuit" class="SettingButton ExitButton"/>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>